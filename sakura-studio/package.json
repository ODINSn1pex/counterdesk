{
  "name": "sakura-studio",
  "productName": "Sakura Studio",
  "version": "2.0.0",
  "description": "Sakura Studio – Bildbearbeitung",
  "author": "Sakura Studio",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "de.sakurastudio.app",
    "productName": "Sakura Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sakura Studio",
      "include": "build/installer.nsh",
      "artifactName": "Sakura-Studio-Setup-${version}.${ext}",
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ]
    },
    "portable": {
      "artifactName": "Sakura-Studio-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "sakura",
        "name": "Sakura Studio Projekt",
        "description": "Sakura Studio Projekt"
      }
    ],
    "afterPack": "build/afterPack.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ag-psd": "^22.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "onnxruntime-web": "^1.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^2.0.3",
    "vite": "^5.4.11"
  }
}
